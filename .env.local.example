# Frontend env vars for local development
# Copy this to .env.local and fill in values

# Point frontend to your backend API
VITE_API_URL=http://localhost:8000/api

# Set to true to run this deployment as admin-only panel
# (no public website, just the admin routes at /)
# Use this in Vercel for your admin.prodivity.in deployment
VITE_ADMIN_MODE=false
